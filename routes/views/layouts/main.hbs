<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Quản lý Sách</title>
    <style>
        body {
            font-family: system-ui, sans-serif;
            max-width: 900px;
            margin: 2rem auto;
            padding: 0 1rem
        }

        input,
        button {
            padding: .4rem;
            margin: .2rem
        }

        table {
            border-collapse: collapse;
            width: 100%;
            margin-top: 1rem
        }

        th,
        td {
            border: 1px solid #ccc;
            padding: .5rem;
            text-align: left
        }

        .error {
            color: #b00020;
            font-weight: 600
        }

        footer {
            margin-top: 2rem;
            color: #555
        }
    </style>
</head>

<body>
    {{{body}}}
    <footer>
        <hr>
        <p>{{HO_TEN}} – MSSV: {{MSSV}} – VAT áp dụng: {{VAT}}%</p>
        {{#if sessionViews}}<small>Số lần truy cập trong phiên: {{sessionViews}}</small>{{/if}}
    </footer>
</body>

</html>